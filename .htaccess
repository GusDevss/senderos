# Configuración para Hostinger (servidor LiteSpeed, compatible con .htaccess de Apache).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# No permitir ver archivos ocultos ni de configuración
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS y dominio sin www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://lossenderosresidencial.com.mx%{REQUEST_URI} [L,R=301]

  # Redirecciones 301 desde las URLs del WordPress anterior
  RewriteRule ^privacy-policy/?$ /aviso-de-privacidad.html [L,R=301]
  RewriteRule ^aviso-de-privacidad/?$ /aviso-de-privacidad.html [L,R=301]
  RewriteRule ^feed/?$ / [L,R=301]
  RewriteRule ^comments/feed/?$ / [L,R=301]

  # El blog se eliminó: su portada, categorías, etiquetas y autores van al inicio
  RewriteRule ^blog-de-terrenos-los-senderos(/.*)?$ / [L,R=301]
  RewriteRule ^(category|tag|author)(/.*)?$ / [L,R=301]

  # Rutas internas de WordPress que ya no existen: 410 (eliminado) para que Google las quite rápido
  RewriteRule ^(wp-admin|wp-includes|wp-json|wp-content)(/.*)?$ - [G,L]
  RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-cron\.php)$ - [G,L]
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml application/manifest+json
</IfModule>

# Caché del navegador
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 6 months"
</IfModule>

# El HTML siempre se revisa con el servidor; CSS y JS llevan ?v=... en su URL,
# así que cada versión nueva se descarga aunque el navegador tenga la anterior.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

AddType image/webp .webp
AddType video/mp4 .mp4
AddType application/manifest+json .webmanifest
